#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "$(uname -s)" in
  Darwin)
    exec bash "$repo_root/scripts/bootstrap.d/macos.sh" "$@"
    ;;
  Linux)
    exec bash "$repo_root/scripts/bootstrap.d/linux.sh" "$@"
    ;;
  *)
    printf 'Unsupported OS for scripts/bootstrap: %s\n' "$(uname -s)" >&2
    printf 'On Windows PowerShell, use: .\\scripts\\bootstrap.ps1\n' >&2
    exit 2
    ;;
esac
