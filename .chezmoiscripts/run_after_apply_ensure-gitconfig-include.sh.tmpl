#!/usr/bin/env bash
set -euo pipefail

gitconfig="$HOME/.gitconfig"
base_path="$HOME/.config/git/base.gitconfig"
include_path="~/.config/git/base.gitconfig"

[[ -f "$base_path" ]] || exit 0

if [[ -f "$gitconfig" ]] && grep -Fq "$include_path" "$gitconfig"; then
  exit 0
fi

mkdir -p "$(dirname "$gitconfig")"
touch "$gitconfig"

tmp_file="$(mktemp)"
trap 'rm -f "$tmp_file"' EXIT

{
  printf '[include]\n'
  printf '\tpath = %s\n' "$include_path"
  if [[ -s "$gitconfig" ]]; then
    printf '\n'
    cat "$gitconfig"
  fi
} > "$tmp_file"

cat "$tmp_file" > "$gitconfig"
