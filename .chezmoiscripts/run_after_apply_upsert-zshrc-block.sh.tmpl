#!/usr/bin/env bash
set -euo pipefail

target="$HOME/.zshrc"
managed_start='# >>> chezmoi dotfiles zsh start >>>'
managed_end='# <<< chezmoi dotfiles zsh end <<<'
managed_body='source "$HOME/.config/dotfiles/zsh/entry.zsh"'

mkdir -p "$(dirname "$target")"
touch "$target"

tmp_file="$(mktemp)"
trap 'rm -f "$tmp_file"' EXIT

awk \
  -v target="$target" \
  -v managed_start="$managed_start" \
  -v managed_end="$managed_end" \
  -v managed_body="$managed_body" '
{
  lines[++line_count] = $0
  if ($0 == managed_start) {
    start_count++
    start_index = line_count
  }
  if ($0 == managed_end) {
    end_count++
    end_index = line_count
  }
}
END {
  if (start_count != end_count) {
    printf "%s: managed zsh block markers are unbalanced\n", target > "/dev/stderr"
    exit 1
  }

  if (start_count > 1) {
    printf "%s: multiple managed zsh blocks found\n", target > "/dev/stderr"
    exit 1
  }

  out_count = 0

  if (start_count == 1) {
    if (end_index <= start_index) {
      printf "%s: managed zsh block end marker appears before start marker\n", target > "/dev/stderr"
      exit 1
    }

    prefix_end = start_index - 1
    while (prefix_end > 0 && lines[prefix_end] == "") {
      prefix_end--
    }

    suffix_start = end_index + 1
    while (suffix_start <= line_count && lines[suffix_start] == "") {
      suffix_start++
    }

    for (i = 1; i <= prefix_end; i++) {
      out[++out_count] = lines[i]
    }
    if (out_count > 0) {
      out[++out_count] = ""
    }
    out[++out_count] = managed_start
    out[++out_count] = managed_body
    out[++out_count] = managed_end

    if (suffix_start <= line_count) {
      out[++out_count] = ""
      for (i = suffix_start; i <= line_count; i++) {
        out[++out_count] = lines[i]
      }
    }
  } else {
    last = line_count
    while (last > 0 && lines[last] == "") {
      last--
    }

    for (i = 1; i <= last; i++) {
      out[++out_count] = lines[i]
    }
    if (out_count > 0) {
      out[++out_count] = ""
    }
    out[++out_count] = managed_start
    out[++out_count] = managed_body
    out[++out_count] = managed_end
  }

  for (i = 1; i <= out_count; i++) {
    print out[i]
  }
}
' "$target" > "$tmp_file"

cat "$tmp_file" > "$target"
