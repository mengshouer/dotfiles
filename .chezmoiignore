# Repository metadata — never apply to $HOME.
README.md
README.zh-CN.md
LICENSE
scripts
scripts/**

# Do not add ".local" here: patterns match target paths, so it would hide
# everything deployed from dot_local/ (e.g. ~/.local/bin/toclip). chezmoi
# already skips source entries that start with a literal dot.

# pixi state is machine-local: bootstrap installs the binary and the wrapper
# in .config/dotfiles/zsh/60-pixi.zsh manages tools, but the global manifest
# and every environment stay on the machine that created them.
.config/pixi
.config/pixi/**
.pixi
.pixi/**

{{ if eq .chezmoi.os "windows" }}
.zshrc
.zimrc
.zshenv
.config/dotfiles/zsh
.config/dotfiles/zsh/**
.local
.local/**
.chezmoiscripts/apply_protect-overwrite.sh
.chezmoiscripts/apply_ensure-gitconfig-include.sh
.chezmoiscripts/apply_reconcile-zshenv-block.sh
.chezmoiscripts/apply_upsert-zshrc-block.sh
{{ else }}
Documents
Documents/**
.config/dotfiles/pwsh
.config/dotfiles/pwsh/**
.chezmoiscripts/apply_protect-overwrite.ps1
.chezmoiscripts/apply_ensure-gitconfig-include.ps1
{{ end }}
