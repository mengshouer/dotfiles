# Repository metadata — never apply to $HOME.
README.md
README.zh-CN.md
LICENSE
scripts
scripts/**

# Do not add ".local" here: patterns match target paths, so it would hide
# everything deployed from dot_local/ (e.g. ~/.local/bin/toclip). chezmoi
# already skips source entries that start with a literal dot.

# mise state is machine-local: the bootstrap installs the binary into
# ~/.local/bin and mise keeps installs, shims, caches and lockfiles under the
# current user's XDG directories.
.config/mise
.config/mise/**
.local/share/mise
.local/share/mise/**
.local/state/mise
.local/state/mise/**
.cache/mise
.cache/mise/**
Library/Caches/mise
Library/Caches/mise/**

{{ if eq .chezmoi.os "windows" }}
.bashrc
.zshrc
.zimrc
.zshenv
.config/dotfiles/bash
.config/dotfiles/bash/**
.config/dotfiles/zsh
.config/dotfiles/zsh/**
.local
.local/**
.chezmoiscripts/apply_protect-overwrite.sh
.chezmoiscripts/apply_ensure-gitconfig-include.sh
.chezmoiscripts/apply_reconcile-zshenv-block.sh
.chezmoiscripts/apply_upsert-bashrc-block.sh
.chezmoiscripts/apply_upsert-zshrc-block.sh
{{ else }}
Documents
Documents/**
.config/dotfiles/pwsh
.config/dotfiles/pwsh/**
.chezmoiscripts/apply_protect-overwrite.ps1
.chezmoiscripts/apply_ensure-gitconfig-include.ps1
{{ end }}
