#!/bin/sh
#
# toclip - copy text into the clipboard of the machine you are looking at.
#
#   local session -> use the platform's native clipboard tool
#                    (pbcopy / wl-copy / xclip / xsel / clip.exe)
#   SSH session   -> emit an OSC 52 escape sequence so the terminal emulator
#                    in front of you sets its own clipboard
#
# Environment variables:
#   TOCLIP_MODE     auto (default) | local | osc52
#   TOCLIP_MAX_KIB  size threshold for the OSC 52 path in KiB (default 64);
#                   0 means unlimited
#
# POSIX sh; uses "local" and "test -ef" (dash, bash, ash and macOS /bin/sh all
# support them).
# shellcheck disable=SC3043 # local is available in every shell this targets

set -u
# Disable globbing: PATH and /proc contents are deliberately word-split below
# (see proc_ppid and resolve_command_paths).
set -f

PROG=toclip
DEFAULT_MAX_KIB=64

TMP_FILE=''
NATIVE_BACKEND=''
NATIVE_DESCRIPTION=''
SELF_PATH=''
SHADOW_PATHS=''
STDOUT_IS_TTY=0
[ -t 1 ] && STDOUT_IS_TTY=1

usage() {
  cat <<'EOF'
Usage: toclip [options] [file...]
       command | toclip [options]

Copy text into the clipboard of the machine you are looking at.
A local session uses this machine's clipboard tool; an SSH session emits an
OSC 52 sequence that the terminal emulator handles.

Options:
  -y, --yes           do not ask when the content exceeds the size threshold
      --max-kib N     size threshold in KiB, default 64; 0 means unlimited
      --local         force the native clipboard tool
      --osc52         force OSC 52
      --print-base64  print the base64 payload to stdout (debugging only)
      --which         print how this session is resolved, then exit
  -h, --help          show this help

Environment variables:
  TOCLIP_MODE     auto (default) | local | osc52
  TOCLIP_MAX_KIB  same as --max-kib

Exit codes:
  0 ok   1 failed/cancelled   2 usage error   3 too large and no terminal
EOF
}

err() { printf '%s: %s\n' "$PROG" "$1" >&2; }
warn() { printf '%s: warning: %s\n' "$PROG" "$1" >&2; }
die() { err "$1"; exit "${2:-1}"; }

cleanup() {
  [ -n "$TMP_FILE" ] && rm -f -- "$TMP_FILE"
}
trap 'cleanup' EXIT HUP INT TERM

# ------------------------------------------------------- environment probes ---

# Print the executable name of process $1 (may include a path).
proc_comm() {
  if [ -r "/proc/$1/comm" ]; then
    cat "/proc/$1/comm" 2>/dev/null
    return 0
  fi
  ps -o comm= -p "$1" 2>/dev/null | tr -d '\n'
  return 0
}

# Print the parent pid of process $1.
proc_ppid() {
  if [ -r "/proc/$1/stat" ]; then
    stat_line=$(cat "/proc/$1/stat" 2>/dev/null) || stat_line=''
    if [ -n "$stat_line" ]; then
      rest=${stat_line##*)} # drop "pid (comm)"; comm may contain spaces or )
      # shellcheck disable=SC2086 # fields are space separated and globbing is off
      set -- $rest # $1=state $2=ppid
      if [ -n "${2:-}" ]; then
        printf '%s\n' "$2"
        return 0
      fi
    fi
  fi
  local ppid

  ppid=$(ps -o ppid= -p "$1" 2>/dev/null | tr -d ' \n')
  [ -n "$ppid" ] || return 1
  printf '%s\n' "$ppid"
}

# Check whether this session came in over sshd. Environment variables first,
# then the process tree, because sudo's env_reset strips SSH_*.
session_is_remote() {
  if [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
    return 0
  fi

  local pid hops comm

  pid=$$
  hops=0
  while [ "$hops" -lt 10 ]; do
    comm=$(proc_comm "$pid" 2>/dev/null) || comm=''
    case "${comm##*/}" in
      sshd | sshd:*) return 0 ;;
    esac
    pid=$(proc_ppid "$pid" 2>/dev/null) || return 1
    case "$pid" in '' | 0 | 1) return 1 ;; esac
    hops=$((hops + 1))
  done
  return 1
}

is_wsl() {
  if [ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]; then
    return 0
  fi
  [ -r /proc/version ] && grep -qi microsoft /proc/version 2>/dev/null
}

# Only looks at what this machine can offer, ignoring how far away the session
# is. Sets NATIVE_BACKEND / NATIVE_DESCRIPTION.
detect_native_backend() {
  NATIVE_BACKEND=''
  NATIVE_DESCRIPTION=''

  # WSL: clip.exe expects UTF-16LE, so non-ASCII text has to be transcoded.
  if is_wsl && command -v clip.exe >/dev/null 2>&1; then
    if command -v iconv >/dev/null 2>&1; then
      NATIVE_BACKEND=wsl-iconv
      NATIVE_DESCRIPTION="clip.exe (iconv UTF-16LE) -> $(command -v clip.exe)"
    else
      NATIVE_BACKEND=wsl-raw
      NATIVE_DESCRIPTION="clip.exe (raw bytes, no iconv) -> $(command -v clip.exe)"
    fi
    return 0
  fi

  case "$(uname -s 2>/dev/null)" in
    Darwin)
      if command -v pbcopy >/dev/null 2>&1; then
        NATIVE_BACKEND=pbcopy
        NATIVE_DESCRIPTION="pbcopy -> $(command -v pbcopy)"
        return 0
      fi
      ;;
  esac

  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    NATIVE_BACKEND=wl-copy
    NATIVE_DESCRIPTION="wl-copy -> $(command -v wl-copy)"
    return 0
  fi

  if [ -n "${DISPLAY:-}" ]; then
    if command -v xclip >/dev/null 2>&1; then
      NATIVE_BACKEND=xclip
      NATIVE_DESCRIPTION="xclip -selection clipboard -in -> $(command -v xclip)"
      return 0
    fi
    if command -v xsel >/dev/null 2>&1; then
      NATIVE_BACKEND=xsel
      NATIVE_DESCRIPTION="xsel --clipboard --input -> $(command -v xsel)"
      return 0
    fi
  fi

  return 1
}

# Echo the mode that will actually be used, so --which and the real run cannot
# drift apart. $1 = requested mode, $2 = 1 when the session is remote.
resolve_effective_mode() {
  if [ "$1" != auto ]; then
    printf '%s\n' "$1"
    return 0
  fi

  if [ -n "$NATIVE_BACKEND" ] && [ "$2" -eq 0 ]; then
    printf 'local\n'
  else
    printf 'osc52\n'
  fi
}

native_copy() {
  case "$NATIVE_BACKEND" in
    pbcopy) command pbcopy <"$1" ;;
    wl-copy) command wl-copy <"$1" ;;
    xclip) command xclip -selection clipboard -in <"$1" ;;
    xsel) command xsel --clipboard --input <"$1" ;;
    wsl-iconv) command iconv -f UTF-8 -t UTF-16LE <"$1" | command clip.exe ;;
    wsl-raw) command clip.exe <"$1" ;;
    *) return 1 ;;
  esac
}

# Record where this script was found (SELF_PATH) and any other executable named
# toclip on PATH (SHADOW_PATHS, newline separated).
resolve_command_paths() {
  SELF_PATH=''
  SHADOW_PATHS=''

  case "$0" in
    */*) SELF_PATH=$0 ;;
  esac

  local saved_ifs dir candidate

  saved_ifs=$IFS
  IFS=:
  # shellcheck disable=SC2086 # PATH is deliberately split on colons
  set -- $PATH
  IFS=$saved_ifs

  for dir in "$@"; do
    [ -n "$dir" ] || continue
    case "$dir" in /*) ;; *) continue ;; esac
    candidate="$dir/$PROG"
    [ -x "$candidate" ] && [ ! -d "$candidate" ] || continue

    # Skip ourselves; -ef also covers symlinks and relative invocations.
    if [ -n "$SELF_PATH" ]; then
      [ "$candidate" -ef "$SELF_PATH" ] && continue
    else
      # $0 had no path component (called through PATH): first hit is us.
      SELF_PATH=$candidate
      continue
    fi

    if [ -z "$SHADOW_PATHS" ]; then
      SHADOW_PATHS=$candidate
    else
      SHADOW_PATHS="$SHADOW_PATHS
$candidate"
    fi
  done
}

# ------------------------------------------------------------- terminal I/O ---

tty_available() {
  # Do not use "{ : >/dev/tty; }" or "exec 9>/dev/tty" here: dash aborts the
  # whole script when a compound command or exec redirection fails (rc=2).
  # Only a failed redirection on a simple command is survivable.
  (cat </dev/null >/dev/tty) 2>/dev/null
}

# Like tty_available, but for reading. Same dash caveat: the redirection sits on
# a simple command inside a subshell, so a failure cannot abort the script.
tty_readable() {
  (true </dev/tty) 2>/dev/null
}

# Write stdin to the controlling terminal, falling back to stdout when it is a
# terminal. The redirection sits on "cat" alone so dash cannot bail out.
write_to_terminal() {
  if cat >/dev/tty 2>/dev/null; then
    return 0
  fi
  if [ "$STDOUT_IS_TTY" -eq 1 ]; then
    cat
    return 0
  fi
  return 1
}

# $1 = single line base64 payload
emit_osc52() {
  (
    if [ -n "${TMUX:-}" ]; then
      # tmux defaults to set-clipboard=external, which swallows a bare OSC 52
      # from applications. Send a DCS passthrough prefix first (needs
      # allow-passthrough on), then the bare sequence (used when
      # set-clipboard=on). Both carry the same payload, so either path is fine.
      # shellcheck disable=SC1003 # ends with ESC + backslash, not a quote
      printf '\033Ptmux;\033\033]52;c;%s\a\033\\' "$1"
    fi
    printf '\033]52;c;%s\a' "$1"
  ) | write_to_terminal
}

format_size() {
  if [ "$1" -ge 1048576 ]; then
    printf '%s.%s MiB' "$(($1 / 1048576))" "$(($1 % 1048576 * 10 / 1048576))"
  elif [ "$1" -ge 1024 ]; then
    printf '%s.%s KiB' "$(($1 / 1024))" "$(($1 % 1024 * 10 / 1024))"
  else
    printf '%s B' "$1"
  fi
}

# $1 = prompt text. 0 = continue, 1 = cancelled, 2 = no usable terminal.
confirm_continue() {
  if ! printf '%s' "$1" | write_to_terminal; then
    return 2
  fi

  # The prompt may have gone out through the stdout fallback while there is
  # nothing to read an answer from (stdout is a terminal but this process has no
  # controlling terminal). Report "no terminal" so the caller exits 3 with the
  # -y hint instead of pretending the user cancelled.
  if ! tty_readable; then
    return 2
  fi

  local reply=''

  IFS= read -r reply </dev/tty 2>/dev/null || reply=''
  case "$reply" in
    y | Y | yes | YES | Yes) return 0 ;;
  esac
  return 1
}

# ---------------------------------------------------------------- commands ---

print_which() {
  local is_remote="$1" mode="$2" max_kib="$3" effective

  if [ "$is_remote" -eq 1 ]; then
    if [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
      printf 'session        : remote (SSH_* environment variables)\n'
    else
      printf 'session        : remote (sshd found in the process tree)\n'
    fi
  else
    printf 'session        : local\n'
  fi

  effective=$(resolve_effective_mode "$mode" "$is_remote")
  printf 'mode           : %s -> %s\n' "$mode" "$effective"

  if [ -n "$NATIVE_BACKEND" ]; then
    printf 'native backend : %s\n' "$NATIVE_DESCRIPTION"
  else
    printf 'native backend : (none)\n'
  fi
  printf 'max-kib        : %s\n' "$max_kib"

  if tty_available; then
    printf 'controlling tty: available (/dev/tty)\n'
  elif [ "$STDOUT_IS_TTY" -eq 1 ]; then
    printf 'controlling tty: unavailable, falling back to stdout\n'
  else
    printf 'controlling tty: unavailable\n'
  fi

  [ -n "${TMUX:-}" ] && printf 'tmux           : inside tmux, DCS passthrough is sent as well\n'
  [ -n "$SELF_PATH" ] && printf 'self           : %s\n' "$SELF_PATH"
  if [ -n "$SHADOW_PATHS" ]; then
    printf 'other %-9s: %s\n' "$PROG" "$(printf '%s' "$SHADOW_PATHS" | tr '\n' ' ')"
  fi
  return 0
}

main() {
  local mode max_kib assume_yes print_base64 want_which is_remote effective
  local size limit path payload trimmed_max_kib

  # Trim and lowercase so that "TOCLIP_MODE=' OSC52 '" works like the PowerShell side.
  mode=$(printf '%s' "${TOCLIP_MODE:-auto}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  max_kib=$DEFAULT_MAX_KIB
  assume_yes=0
  print_base64=0
  want_which=0

  if [ -n "${TOCLIP_MAX_KIB:-}" ]; then
    # Trim like the PowerShell side does; ' 64 ' should not be a usage error.
    trimmed_max_kib=$(printf '%s' "$TOCLIP_MAX_KIB" | tr -d '[:space:]')
    case "$trimmed_max_kib" in
      '' | *[!0-9]*) die "TOCLIP_MAX_KIB must be an integer >= 0: '$TOCLIP_MAX_KIB'" 2 ;;
      *) max_kib=$trimmed_max_kib ;;
    esac
  fi

  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help)
        usage
        return 0
        ;;
      -y | --yes)
        assume_yes=1
        shift
        ;;
      --local)
        mode=local
        shift
        ;;
      --osc52)
        mode=osc52
        shift
        ;;
      --print-base64)
        print_base64=1
        shift
        ;;
      --which)
        want_which=1
        shift
        ;;
      --max-kib)
        [ $# -ge 2 ] || die "--max-kib requires a value" 2
        max_kib=$2
        shift 2
        ;;
      --max-kib=*)
        max_kib=${1#*=}
        shift
        ;;
      --)
        shift
        break
        ;;
      -)
        break # a single dash means stdin
        ;;
      -*)
        die "unknown option: $1 (see --help)" 2
        ;;
      *)
        break
        ;;
    esac
  done

  case "$max_kib" in
    '' | *[!0-9]*) die "--max-kib must be an integer >= 0: '$max_kib'" 2 ;;
  esac
  case "$mode" in
    auto | local | osc52) ;;
    *) die "TOCLIP_MODE must be auto|local|osc52: '$mode'" 2 ;;
  esac

  is_remote=0
  session_is_remote && is_remote=1
  detect_native_backend || true
  resolve_command_paths

  if [ "$want_which" -eq 1 ]; then
    print_which "$is_remote" "$mode" "$max_kib"
    return 0
  fi

  if [ -n "$SHADOW_PATHS" ]; then
    warn "another $PROG is also on PATH: $(printf '%s' "$SHADOW_PATHS" | tr '\n' ' ')"
  fi

  TMP_FILE=$(mktemp "${TMPDIR:-/tmp}/$PROG.XXXXXX") || die "cannot create a temporary file" 1

  if [ $# -gt 0 ]; then
    for path in "$@"; do
      if [ "$path" = '-' ]; then
        cat >>"$TMP_FILE" || die "cannot read standard input" 1
        continue
      fi
      [ -e "$path" ] || die "no such file: $path" 1
      [ -d "$path" ] && die "is a directory: $path" 1
      [ -r "$path" ] || die "cannot read: $path" 1
      cat -- "$path" >>"$TMP_FILE" || die "cannot read: $path" 1
    done
  else
    if [ -t 0 ]; then
      err "reading from standard input; press Ctrl-D when done"
    fi
    cat >>"$TMP_FILE" || die "cannot read standard input" 1
  fi

  size=$(wc -c <"$TMP_FILE" | tr -d ' \t')
  case "$size" in '' | *[!0-9]*) size=0 ;; esac

  effective=$(resolve_effective_mode "$mode" "$is_remote")
  if [ "$effective" = local ] && [ -z "$NATIVE_BACKEND" ]; then
    die "no clipboard backend on this machine; use --osc52 or install xclip / wl-clipboard" 1
  fi

  if [ "$effective" = local ] && [ "$print_base64" -eq 0 ]; then
    if native_copy "$TMP_FILE"; then
      return 0
    fi
    # Symmetric with the PowerShell side: only an auto-mode pick falls back to
    # OSC 52; an explicitly requested --local / TOCLIP_MODE=local failure is
    # reported as an error instead.
    if [ "$mode" != auto ]; then
      die "copying to the clipboard failed (backend: $NATIVE_BACKEND)" 1
    fi
    warn "$NATIVE_BACKEND failed; falling back to OSC 52"
    effective=osc52
  fi

  command -v base64 >/dev/null 2>&1 || die "base64 is required but not available" 1
  payload=$(base64 <"$TMP_FILE" 2>/dev/null | tr -d '\n')
  if [ -z "$payload" ] && [ "$size" -gt 0 ]; then
    die "base64 encoding failed" 1
  fi

  if [ "$print_base64" -eq 1 ]; then
    printf '%s\n' "$payload"
    return 0
  fi

  if [ "$max_kib" -gt 0 ]; then
    limit=$((max_kib * 1024))
    if [ "$size" -gt "$limit" ] && [ "$assume_yes" -eq 0 ]; then
      confirm_continue "$PROG: content is $(format_size "$size"), above the ${max_kib} KiB threshold; some terminals truncate or drop long OSC 52 sequences. Continue? [y/N] "
      case "$?" in
        0) ;;
        2)
          die "content is $(format_size "$size"), above the ${max_kib} KiB threshold and there is no terminal to confirm on; use -y to continue or --max-kib 0 to lift the limit" 3
          ;;
        *) die "cancelled" 1 ;;
      esac
    fi
  fi

  emit_osc52 "$payload" || die "cannot write the OSC 52 sequence to the terminal" 1
  return 0
}

main "$@"
